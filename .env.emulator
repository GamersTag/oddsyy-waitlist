VITE_FIREBASE_STORAGE_BUCKET=demo-oddsyy.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:0
VITE_FIRESTORE_EMULATOR=127.0.0.1:8085
