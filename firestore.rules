rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff who may use /admin: Google sign-in, verified email, and a document
    // at admins/{email} (created by the project owner in the Firebase console).
    // The list lives in the database, not here, because this repo is public.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /waitlist/{docId} {
      // Sign-ups are write-only from the public site. The doc ID is the SHA-256
      // hex of the trimmed, lower-cased email, so a repeat sign-up targets an
      // existing doc, counts as an update, and is denied -- that's the
      // duplicate check. Nothing about other sign-ups is ever readable.
      allow create: if docId.matches('^[0-9a-f]{64}$')
                   && request.resource.data.keys().hasAll(['name', 'email', 'role', 'created_at'])
                   && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'created_at'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 100
                   && request.resource.data.email is string
                   && request.resource.data.email.size() <= 254
                   && request.resource.data.email == request.resource.data.email.trim().lower()
                   && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                   // Bind the ID to the email so nobody can squat someone else's slot
                   && docId == hashing.sha256(request.resource.data.email).toHexString().lower()
                   && request.resource.data.role in ['seeker', 'hustler', 'both']
                   && request.resource.data.created_at == request.time;

      // Only staff can read (the admin export) or delete (privacy requests).
      // Rules can't tell a count query from a full list, so the public site
      // gets no read access at all.
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // The public sign-up count shown on the landing page — the only number
    // anyone can read. A visitor can raise it by exactly one, and only in the
    // same write as a brand-new sign-up: `last` names that sign-up, which must
    // not exist before the write and must exist after it. So the count can't be
    // inflated without adding real sign-ups, and each sign-up counts once.
    // Staff keep it in step when they delete an entry.
    match /stats/waitlist {
      allow get: if true;
      allow update: if request.resource.data.keys().hasOnly(['count', 'last'])
                   && request.resource.data.count == resource.data.count + 1
                   && request.resource.data.last is string
                   && request.resource.data.last.matches('^[0-9a-f]{64}$')
                   && !exists(/databases/$(database)/documents/waitlist/$(request.resource.data.last))
                   && existsAfter(/databases/$(database)/documents/waitlist/$(request.resource.data.last));
      allow update: if isAdmin()
                   && request.resource.data.keys().hasOnly(['count', 'last'])
                   && request.resource.data.count is int
                   && request.resource.data.count >= 0;
    }

    // Allow-list of staff emails. Managed only from the Firebase console.
    match /admins/{email} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
